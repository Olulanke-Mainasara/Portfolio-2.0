---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"blog">;
  index: number;
  readingTime: number;
}

const { post, index, readingTime } = Astro.props;
const numeral = `(0${index})`;
const restClip =
  index % 2 === 0
    ? "35% 30%, 75% 30%, 65% 70%, 25% 70%"
    : "25% 30%, 65% 30%, 75% 70%, 35% 70%";
const formattedDate = post.data.pubDate.toLocaleDateString("en-US", {
  month: "short",
  day: "numeric",
  year: "numeric",
});
---

<a
  href={`/blog/${post.id}`}
  class="group post-card-reveal block"
  data-tags={JSON.stringify(post.data.tags.map((t) => t.toLowerCase()))}
>
  <div
    class="relative aspect-video w-full overflow-hidden rounded-lg"
  >
    <Image
      src={post.data.coverImage}
      alt=""
      aria-hidden="true"
      class="absolute inset-0 h-full w-full scale-105 object-cover object-center blur-2xl brightness-50"
    />
    <Image
      src={post.data.coverImage}
      alt={post.data.coverImageAlt}
      transition:name={`cover-${post.id}`}
      class="reveal-mask absolute inset-0 h-full w-full object-cover"
      style={`--clip-rest: ${restClip}`}
    />
  </div>

  <div class="mt-4 flex items-center justify-between gap-4 md:mt-6">
    <div>
      <p class="text-3xl md:text-5xl">{post.data.title}</p>
      <p class="mt-2 max-w-md text-base font-thin opacity-70 md:text-lg">
        {post.data.description}
      </p>
      <div
        class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs tracking-widest text-white/40 light:text-neutral-900/40 uppercase"
      >
        <span>{formattedDate}</span>
        <span>{readingTime} min read</span>
      </div>
    </div>
    <div class="flex shrink-0 flex-col items-end gap-2">
      <span class="text-xl text-background md:text-2xl">{numeral}</span>
      <span
        class="flex items-center gap-2 text-sm group/link md:text-base"
      >
        <span>Read</span>
        <span class="duration-300 group-hover/link:translate-x-1">→</span>
      </span>
    </div>
  </div>
</a>

<style>
  .reveal-mask {
    clip-path: polygon(var(--clip-rest));
    transition: clip-path 0.6s ease-out;
  }

  @media (hover: none) {
    .post-card-reveal.in-view .reveal-mask {
      clip-path: polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%);
    }
  }

  @media (hover: hover) {
    .group:hover .reveal-mask {
      clip-path: polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%);
    }
  }

  .post-card-reveal {
    opacity: 0;
    transform: translateY(2rem);
    transition:
      opacity 0.7s ease-out,
      transform 0.7s ease-out;
  }

  .post-card-reveal.in-view {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  function initPostCardReveal() {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add("in-view");
          observer.unobserve(entry.target);
        });
      },
      { threshold: 0.3 },
    );

    document
      .querySelectorAll(".post-card-reveal:not(.in-view)")
      .forEach((el) => observer.observe(el));
  }

  document.addEventListener("astro:page-load", initPostCardReveal);
</script>
