---
import { Icon } from "astro-icon/components";
import { projects } from "@/data";
import ProjectCard from "../Shared/UI/ProjectCard.astro";
import Project4 from "@/images/Project4.webp";
import Project3 from "@/images/Project3.webp";
import Project1 from "@/images/Project1.webp";
import { Image } from "astro:assets";
---

<section
  class="min-h-screen mt-32 space-y-8 text-white md:space-y-16 max-w-screen-2xl mx-auto"
>
  <h2 class="text-center text-8xl md:text-9xl">Projects</h2>

  <div class="flex flex-col gap-28">
    {
      projects.slice(0, 6).map((project, index) => {
        return <ProjectCard project={project} index={index + 1} />;
      })
    }
    <div
      class="flex flex-col md:flex-row justify-center gap-4 md:gap-8 xl:gap-4 px-4 lg:px-8 xl:w-[95%] md:mx-auto rounded-lg"
    >
      <div class="flex items-center justify-center basis-1/2">
        <div class="grid grid-cols-2 grid-rows-2 gap-4 lg:gap-8">
          <div class="col-span-2 overflow-hidden rounded-lg max-h-64 group">
            <Image
              src={Project1}
              class="object-cover object-top w-full h-full duration-300 group-hover:scale-110"
              alt="Agency.io"
            />
          </div>
          <div
            class="overflow-hidden rounded-lg max-h-64 group border border-neutral-900"
          >
            <Image
              src={Project4}
              class="object-cover w-full h-full duration-300 group-hover:scale-110"
              alt="FunXplorer"
            />
          </div>
          <div class="overflow-hidden rounded-lg max-h-64 group">
            <Image
              src={Project3}
              class="object-cover object-left w-full h-full duration-300 group-hover:scale-110"
              alt="NextGen Patients"
            />
          </div>
        </div>
      </div>

      <div class="flex xl:justify-center basis-1/2">
        <div class="flex flex-col justify-center h-full gap-4">
          <h3
            class="text-[46px] leading-none md:text-7xl lg:text-8xl xl:text-7xl"
          >
            What are <br class="hidden md:block xl:hidden" /> th👀se?
          </h3>
          <p class="max-w-md font-thin text-xl lg:text-2xl">
            Some of my random doodles, and projects I've played with in the
            background
          </p>
          <a href="/projects" class="flex items-center gap-2 group">
            <span class="text-xl text-white">See all my projects</span>
            <Icon
              name="arrow-right"
              size={30}
              class="text-white duration-300 group-hover:translate-x-1"
            />
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
