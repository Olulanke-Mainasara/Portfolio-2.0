---
import { Icon } from "astro-icon/components";
import { projects } from "@/data";
import ProjectListItem from "../Shared/UI/ProjectListItem.astro";

const featured = projects.slice(0, 6);
---

<section
  class="px-4 mt-32 text-white light:text-neutral-900 lg:px-8 max-w-screen-2xl mx-auto"
>
  <div class="flex flex-col lg:flex-row lg:gap-8 xl:gap-16">
    <div
      class="lg:sticky lg:top-[32%] lg:self-start lg:basis-2/5 xl:basis-1/3 text-center lg:text-left"
    >
      <h2 class="text-6xl leading-[0.9] md:text-8xl">
        Recent <br class="hidden xl:block" /> Work<sup
          class="ml-2 text-2xl align-super md:text-4xl text-background hidden lg:inline-block"
          >({"0" + featured.length})</sup
        >
      </h2>
      <p
        class="max-w-sm mt-6 text-lg font-thin lg:text-xl opacity-80 light:opacity-100 hidden lg:block"
      >
        A handful of things I've shipped recently. The rest live on the full
        projects page.
      </p>
      <a
        href="/projects"
        class="flex items-center w-fit gap-2 mt-6 group mx-auto lg:mx-0"
      >
        <span class="text-lg">See all my projects</span>
        <Icon
          name="arrow-right"
          size={22}
          class="duration-300 group-hover:translate-x-1"
        />
      </a>
    </div>

    <div class="flex flex-col flex-1 gap-16 mt-16 lg:gap-24 lg:mt-0">
      {
        featured.map((project, index) => (
          <ProjectListItem project={project} index={index + 1} />
        ))
      }
    </div>
  </div>
</section>
