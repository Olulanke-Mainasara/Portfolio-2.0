---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

interface Props {
  index: number;
  project: {
    name: string;
    link: string;
    shortDescription: string;
    description: string;
    image: ImageMetadata;
    technologies: string[];
    highlights?: string[];
  };
}

const { index, project } = Astro.props;
const techSlugs = JSON.stringify(
  project.technologies.map((tech) => tech.toLowerCase()),
);
const highlights = project.highlights ?? project.technologies.slice(0, 3);
const isFirst = index === 1;
---

<article
  id={project.name}
  class={`work-entry project-feature-reveal scroll-mt-24 md:scroll-mt-32 ${isFirst ? "reveal-mobile-off" : ""}`}
  data-tech={techSlugs}
>
  <a
    href={project.link}
    target="_blank"
    rel="noopener noreferrer"
    class="group relative flex aspect-video w-full overflow-hidden rounded-2xl sm:aspect-16/10 md:rounded-3xl lg:aspect-21/9"
  >
    <Image
      src={project.image}
      alt={project.name}
      class="absolute inset-0 h-full w-full scale-100 object-cover duration-700 group-hover:scale-105"
    />
    <div
      class="absolute inset-0 hidden bg-linear-to-t from-black/95 via-black/30 to-black/10 md:block"
    >
    </div>

    <div class="absolute inset-x-0 bottom-0 hidden flex-col gap-3 p-6 md:flex md:gap-4 md:p-10">
      <h3 class="text-3xl leading-none text-white md:text-6xl">
        {project.name}
      </h3>
      <div class="flex flex-wrap gap-2">
        {
          highlights.map((tech) => (
            <span class="rounded-full border border-white/20 px-3 py-1 text-xs text-white/80 md:text-sm">
              {tech}
            </span>
          ))
        }
      </div>
    </div>

    <span
      class="absolute right-6 bottom-6 flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-white text-black shadow-lg shadow-black/30 duration-300 group-hover:rotate-45 group-hover:bg-background md:right-10 md:bottom-10 md:h-16 md:w-16"
    >
      <Icon name="arrow-right" class="h-5 w-5 md:h-6 md:w-6" />
    </span>
  </a>

  <div class="mt-6 flex flex-col gap-4 md:hidden">
    <h3 class="text-3xl leading-none text-white light:text-neutral-900">
      {project.name}
    </h3>
    <div class="flex flex-wrap gap-2">
      {
        highlights.map((tech) => (
          <span class="rounded-full border border-white/20 light:border-black/20 px-3 py-1 text-xs text-white/80 light:text-neutral-900/80">
            {tech}
          </span>
        ))
      }
    </div>
  </div>

  <div
    class="mt-6 flex flex-col gap-6 md:flex-row md:items-start md:justify-between md:gap-8"
  >
    <p
      class="max-w-2xl text-lg leading-relaxed font-normal text-white/80 light:text-neutral-900/80 md:text-xl"
    >
      {project.description}
    </p>

    <div
      class="hidden shrink-0 flex-col items-end gap-4 md:flex"
    >
      <span class="text-8xl leading-none text-background">
        {String(index).padStart(2, "0")}
      </span>
      <a
        href={project.link}
        target="_blank"
        rel="noopener noreferrer"
        class="group/link flex items-center gap-2 text-base text-white light:text-neutral-900 duration-300 hover:text-background"
      >
        <span>Visit site</span>
        <Icon
          name="arrow-right"
          class="h-4 w-4 duration-300 group-hover/link:translate-x-1"
        />
      </a>
    </div>
  </div>
</article>

<style>
  .project-feature-reveal {
    opacity: 0;
    transform: translateY(2.5rem);
    transition:
      opacity 0.8s ease-out,
      transform 0.8s ease-out;
  }

  .project-feature-reveal.in-view {
    opacity: 1;
    transform: translateY(0);
  }

  .project-feature-reveal.reveal-mobile-off {
    opacity: 1;
    transform: none;
    transition: none;
  }
</style>

<script>
  function initProjectFeatureReveal() {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add("in-view");
          observer.unobserve(entry.target);
        });
      },
      { threshold: 0.2 },
    );

    document
      .querySelectorAll(".project-feature-reveal:not(.in-view)")
      .forEach((el) => observer.observe(el));
  }

  document.addEventListener("astro:page-load", initProjectFeatureReveal);
</script>
