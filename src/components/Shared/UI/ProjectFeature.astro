---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

interface Props {
  index: number;
  project: {
    name: string;
    link: string;
    shortDescription: string;
    description: string;
    image: ImageMetadata;
    technologies: string[];
  };
}

const { index, project } = Astro.props;
const techSlugs = JSON.stringify(
  project.technologies.map((tech) => tech.toLowerCase()),
);
const isFirst = index === 1;
---

<article
  id={project.name}
  class={`work-entry project-feature-reveal scroll-mt-24 md:scroll-mt-32 ${isFirst ? "reveal-mobile-off" : ""}`}
  data-tech={techSlugs}
>
  <a
    href={project.link}
    target="_blank"
    rel="noopener noreferrer"
    class="group relative flex aspect-video w-full flex-col justify-end overflow-hidden rounded-2xl sm:aspect-16/10 md:rounded-3xl lg:aspect-21/9"
  >
    <Image
      src={project.image}
      alt={project.name}
      class="absolute inset-0 h-full w-full scale-100 object-cover duration-700 group-hover:scale-105"
    />
    <div
      class="absolute inset-0 bg-linear-to-t from-black/95 via-black/30 to-black/10"
    >
    </div>

    <div class="relative flex items-end justify-between gap-4 p-6 md:p-10">
      <div class="flex flex-col gap-3 md:gap-4">
        <h3 class="text-3xl leading-none text-white md:text-6xl">
          {project.name}
        </h3>
        <div class="flex flex-wrap gap-2">
          {
            project.technologies
              .slice(0, 3)
              .map((tech) => (
                <span class="rounded-full border border-white/20 px-3 py-1 text-xs text-white/80 md:text-sm">
                  {tech}
                </span>
              ))
          }
        </div>
      </div>

      <span
        class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-white text-black duration-300 group-hover:rotate-45 group-hover:bg-background md:h-16 md:w-16"
      >
        <Icon name="arrow-right" class="h-5 w-5 md:h-6 md:w-6" />
      </span>
    </div>
  </a>

  <div
    class="mt-6 flex flex-col gap-8 md:flex-row md:items-start md:justify-between"
  >
    <p
      class="max-w-2xl text-lg leading-relaxed font-thin text-white/70 md:text-xl"
    >
      {project.description}
    </p>
  </div>
</article>

<style>
  .project-feature-reveal {
    opacity: 0;
    transform: translateY(2.5rem);
    transition:
      opacity 0.8s ease-out,
      transform 0.8s ease-out;
  }

  .project-feature-reveal.in-view {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 767px) {
    .project-feature-reveal.reveal-mobile-off {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  function initProjectFeatureReveal() {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add("in-view");
          observer.unobserve(entry.target);
        });
      },
      { threshold: 0.2 },
    );

    document
      .querySelectorAll(".project-feature-reveal:not(.in-view)")
      .forEach((el) => observer.observe(el));
  }

  document.addEventListener("astro:page-load", initProjectFeatureReveal);
</script>
