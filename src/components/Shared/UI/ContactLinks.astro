---
import { Icon } from "astro-icon/components";
import SLink from "./SLink.astro";

const { extraStyles } = Astro.props;
---

<div class={`items-center gap-4 text-white light:text-neutral-900 ${extraStyles}`}>
  <a
    href="https://www.instagram.com/grim_redd?utm_source=qr"
    target="_blank"
    rel="noopener noreferrer"
  >
    <Icon
      name={"instagram"}
      size={30}
      class={"hover:scale-125 hover:-rotate-6 duration-300 hover:text-background"}
    />
  </a>
  <a
    href="https://www.linkedin.com/in/mainasara-olulanke-01658a228/"
    target="_blank"
    rel="noopener noreferrer"
  >
    <Icon
      name={"linkedin"}
      size={30}
      class={"hover:scale-125 hover:rotate-6 duration-300 hover:text-background"}
    />
  </a>
  <a
    href="https://github.com/Olulanke-Mainasara"
    target="_blank"
    rel="noopener noreferrer"
  >
    <Icon
      name={"github"}
      size={30}
      class={"hover:scale-125 hover:-rotate-6 duration-300 hover:text-background"}
    />
  </a>
  <a
    href="https://x.com/MainasaraOlu"
    target="_blank"
    rel="noopener noreferrer"
  >
    <Icon
      name={"x"}
      size={30}
      class={"hover:scale-125 hover:rotate-6 duration-300 hover:text-background"}
    />
  </a>
  <SLink
    href="https://calendly.com/mainasara-o-olulanke/30min"
    text="Book a call"
    iconPosition="right"
    icon="arrow-right"
    extraStyles="hidden md:flex text-3xl text-black light:bg-neutral-900 light:text-white gap-3 bg-white pl-4 pr-[6px] py-[6px]"
    iconWandH="large"
    newPage
  />
</div>
