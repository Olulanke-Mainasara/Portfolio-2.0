---
interface Props {
  type?: "fade" | "slide" | "scale";
  direction?: "up" | "down" | "left" | "right";
  distance?: string;
  duration?: string;
  delay?: string;
  class?: string;
}

const {
  type = "fade",
  direction = "up",
  distance = "20px",
  duration = "0.6s",
  delay = "0s",
  class: className = "",
} = Astro.props;

const offsets: Record<string, string> = {
  up: `translateY(${distance})`,
  down: `translateY(-${distance})`,
  left: `translateX(${distance})`,
  right: `translateX(-${distance})`,
};
const initialTransform =
  type === "scale"
    ? "scale(0.94)"
    : type === "slide"
      ? offsets[direction]
      : "none";
---

<div
  class={`reveal ${className}`}
  style={`--reveal-transform: ${initialTransform}; --reveal-duration: ${duration}; --reveal-delay: ${delay};`}
>
  <slot />
</div>

<style>
  .reveal {
    opacity: 0;
    transform: var(--reveal-transform);
    transition:
      opacity var(--reveal-duration) ease var(--reveal-delay),
      transform var(--reveal-duration) ease var(--reveal-delay);
  }
  .reveal.visible {
    opacity: 1;
    transform: none;
  }
</style>

<script>
  import { inView } from "framer-motion/dom";

  let stopReveal: (() => void) | null = null;

  function initReveal() {
    stopReveal?.();
    stopReveal = inView(
      ".reveal",
      (element) => {
        element.classList.add("visible");
      },
      { amount: 0.15 },
    );
  }

  document.addEventListener("astro:page-load", initReveal);
</script>
