---
import Layout from "@/layouts/Layout.astro";
import FeaturedPost from "@/components/Blog/FeaturedPost.astro";
import PostCard from "@/components/Blog/PostCard.astro";
import { getCollection } from "astro:content";
import { getReadingTime } from "@/lib/readingTime";

const allPosts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const [featured, ...rest] = allPosts;

const tags = [
  ...new Set(
    allPosts.flatMap((post) => post.data.tags.map((t) => t.toLowerCase())),
  ),
];
---

<Layout title="Blog - Mainasara Olulanke">
  <main class="mx-auto max-w-screen-2xl pt-14 md:pt-20">
    <section class="px-4 text-center text-white lg:px-8">
      <h1
        class="mt-4 text-7xl leading-[0.85] font-normal tracking-tight sm:text-8xl md:text-[9rem] lg:text-[11rem]"
      >
        Field Notes<span class="text-background">.</span>
      </h1>
    </section>

    {
      featured && (
        <div class="mt-8 md:mt-14 px-4 lg:px-8">
          <FeaturedPost
            post={featured}
            readingTime={getReadingTime(featured.body ?? "")}
          />
        </div>
      )
    }

    {
      rest.length > 0 && (
        <>
          {tags.length > 1 && (
            <div
              id="tag-filters"
              class="mt-10 flex flex-wrap justify-center gap-3 px-4 md:mt-24 lg:px-8"
            >
              <button
                type="button"
                data-tag-filter="all"
                class="tag-chip active rounded-full border border-white/15 px-4 py-2 text-sm tracking-widest text-white uppercase duration-300"
              >
                All
              </button>
              {tags.map((tag) => (
                <button
                  type="button"
                  data-tag-filter={tag}
                  class="tag-chip rounded-full border border-white/15 px-4 py-2 text-sm tracking-widest text-white/50 uppercase duration-300"
                >
                  {tag}
                </button>
              ))}
            </div>
          )}

          <div class="mt-10 grid grid-cols-1 gap-x-8 gap-y-16 px-4 text-white md:mt-16 md:grid-cols-2 lg:px-8">
            {rest.map((post, index) => (
              <PostCard
                post={post}
                index={index + 1}
                readingTime={getReadingTime(post.body ?? "")}
              />
            ))}
          </div>
        </>
      )
    }
  </main>
</Layout>

<style>
  .tag-chip.active {
    color: black;
    background: var(--color-background);
    border-color: var(--color-background);
  }
</style>

<script>
  function initTagFilters() {
    const bar = document.getElementById("tag-filters");
    if (!bar) return;

    const chips = Array.from(
      bar.querySelectorAll<HTMLButtonElement>(".tag-chip"),
    );
    const cards = Array.from(
      document.querySelectorAll<HTMLElement>("[data-tags]"),
    );

    chips.forEach((chip) => {
      chip.addEventListener("click", () => {
        const tag = chip.dataset.tagFilter;
        chips.forEach((c) => c.classList.remove("active"));
        chip.classList.add("active");

        cards.forEach((card) => {
          const cardTags: string[] = JSON.parse(card.dataset.tags || "[]");
          const show = tag === "all" || cardTags.includes(tag ?? "");
          card.style.display = show ? "" : "none";
        });
      });
    });
  }

  document.addEventListener("astro:page-load", initTagFilters);
</script>
