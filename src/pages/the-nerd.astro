---
import Layout from "@/layouts/Layout.astro";
import NerdFeature from "@/components/Shared/UI/NerdFeature.astro";
import { nerdFacts } from "@/data";
---

<Layout
  title="The Nerd - Mainasara Olulanke"
  description="Comics, Lego, space, and F1 — a look at what Mainasara Olulanke geeks out about outside of code."
>
  <main class="mx-auto max-w-screen-2xl pt-16 md:pt-20">
    <section class="px-4 text-center text-white light:text-neutral-900 lg:px-8">
      <h1
        class="mt-4 text-7xl leading-[0.85] font-normal tracking-tight sm:text-8xl md:text-[9rem] lg:text-[11rem]"
      >
        The Nerd<span class="text-background">.</span>
      </h1>
    </section>

    <div
      class="mt-8 flex flex-col gap-28 px-4 text-white light:text-neutral-900 md:mt-14 md:gap-40 lg:px-8"
    >
      {
        nerdFacts.map((fact, index) => (
          <NerdFeature
            index={index}
            label={fact.label}
            title={fact.title}
            description={fact.description}
            image={fact.image}
          />
        ))
      }
    </div>
  </main>
</Layout>
