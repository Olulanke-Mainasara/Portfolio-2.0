---
import ProjectFeature from "@/components/Shared/UI/ProjectFeature.astro";
import Layout from "@/layouts/Layout.astro";
import { projects } from "@/data";
---

<Layout title="Projects - Mainasara Olulanke">
  <main class="mx-auto max-w-screen-2xl pt-14 md:pt-20">
    <section class="px-4 text-white lg:px-8">
      <h1
        class="mt-4 text-center text-7xl leading-[0.85] font-normal tracking-tight sm:text-8xl md:text-[9rem] lg:text-[11rem]"
      >
        Selected Work<span class="text-background">.</span>
      </h1>
    </section>

    <div
      class="mt-8 md:mt-14 flex flex-col gap-24 px-4 text-white md:gap-32 lg:px-8"
    >
      {
        projects.map((project, index) => (
          <ProjectFeature project={project} index={index + 1} />
        ))
      }
    </div>
  </main>
</Layout>
