---
import Nav from "../components/Shared/Nav.astro";
import Footer from "../components/Shared/Footer.astro";
import SmoothScroll from "../components/Shared/UI/SmoothScroll.tsx";
import StructuredData from "../components/Shared/SEO/StructuredData.astro";
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title,
  description = "Mainasara Olulanke — Software Engineer building fast, thoughtful, and beautifully-crafted web experiences.",
  image = "/og-image.jpg",
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL(image, Astro.site);

// Held as strings rather than inline markup: inside an Astro expression the
// braces in this JavaScript would be parsed as template expressions.
const registerServiceWorker = `
  (function () {
    if (!("serviceWorker" in navigator) || window.__swRegistered) return;
    window.__swRegistered = true;
    window.addEventListener("load", function () {
      navigator.serviceWorker.register("/sw.js").catch(function (error) {
        console.error("Service worker registration failed:", error);
      });
    });
  })();
`;

// astro dev and astro preview share port 4321, so a worker installed while
// previewing a production build would otherwise go on serving precached
// assets over the top of the dev server.
const unregisterServiceWorker = `
  (function () {
    if (!("serviceWorker" in navigator)) return;
    navigator.serviceWorker.getRegistrations().then(function (registrations) {
      registrations.forEach(function (registration) {
        registration.unregister();
      });
    });
    if (window.caches) {
      caches.keys().then(function (keys) {
        keys
          .filter(function (key) {
            return key.startsWith("portfolio-");
          })
          .forEach(function (key) {
            caches.delete(key);
          });
      });
    }
  })();
`;
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline>
      (function () {
        function resolveTheme() {
          var stored = localStorage.getItem("theme");
          return (
            stored ||
            (window.matchMedia("(prefers-color-scheme: light)").matches
              ? "light"
              : "dark")
          );
        }
        // Run immediately (before first paint) to avoid a flash.
        document.documentElement.classList.toggle(
          "light",
          resolveTheme() === "light",
        );
        // The router swaps in a freshly-fetched document on every
        // navigation, which has no way to know the client's stored theme
        // preference — apply it to the incoming document before it goes live.
        document.addEventListener("astro:before-swap", function (event) {
          event.newDocument.documentElement.classList.toggle(
            "light",
            resolveTheme() === "light",
          );
        });
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/icons/icon.svg" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#070b0f" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Mainasara" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bangers&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Mainasara Olulanke" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />

    <script is:inline>
      (function () {
        // The theme is a stored preference, not a media query, so the browser
        // chrome colour has to be kept in step by hand.
        if (window.__themeColorSync) return;
        window.__themeColorSync = true;

        function sync() {
          var meta = document.querySelector('meta[name="theme-color"]');
          if (!meta) return;
          var isLight = document.documentElement.classList.contains("light");
          meta.setAttribute("content", isLight ? "#f7f5f2" : "#070b0f");
        }

        sync();
        // Dispatched by ThemeToggle when the user flips the theme.
        window.addEventListener("themechange", sync);
        // The router swaps in a new head, so the old meta element is gone.
        document.addEventListener("astro:after-swap", sync);
      })();
    </script>

    <script is:inline set:html={import.meta.env.PROD ? registerServiceWorker : unregisterServiceWorker} />

    <StructuredData />

    <ClientRouter />
  </head>
  <body class="overflow-x-hidden">
    <SmoothScroll client:load />
    <Nav />
    <slot />
    <Footer />
  </body>
</html>
