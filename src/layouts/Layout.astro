---
import Nav from "../components/Shared/Nav.astro";
import Footer from "../components/Shared/Footer.astro";
import SmoothScroll from "../components/Shared/UI/SmoothScroll.tsx";
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = "Mainasara Olulanke — Frontend Engineer building fast, thoughtful, and beautifully-crafted web experiences.",
  image = "/og-image.jpg",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline>
      (function () {
        function resolveTheme() {
          var stored = localStorage.getItem("theme");
          return (
            stored ||
            (window.matchMedia("(prefers-color-scheme: light)").matches
              ? "light"
              : "dark")
          );
        }
        // Run immediately (before first paint) to avoid a flash.
        document.documentElement.classList.toggle(
          "light",
          resolveTheme() === "light",
        );
        // The router swaps in a freshly-fetched document on every
        // navigation, which has no way to know the client's stored theme
        // preference — apply it to the incoming document before it goes live.
        document.addEventListener("astro:before-swap", function (event) {
          event.newDocument.documentElement.classList.toggle(
            "light",
            resolveTheme() === "light",
          );
        });
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bangers&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Mainasara Olulanke" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />

    <ClientRouter />
  </head>
  <body class="overflow-x-hidden">
    <SmoothScroll client:load />
    <Nav />
    <slot />
    <Footer />
  </body>
</html>
